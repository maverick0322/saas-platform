{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Platform": {
    "RuntimeMode": "Api"
  },
  "ProvisioningWorker": {
    "Enabled": false,
    "MaxAutomaticRetries": 3,
    "LeaseDurationSeconds": 60,
    "InitialRetryDelaySeconds": 15,
    "MaxRetryDelaySeconds": 300,
    "PollIntervalSeconds": 5
  },
  "AllowedHosts": "*"
}
