{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Platform": {
    "RuntimeMode": "Api"
  },
  "Ports": {
    "Http": 8080
  },
  "InternalGrpc": {
    "Enabled": false,
    "Port": 8092,
    "InternalServiceKey": ""
  },
  "AdminApi": {
    "Enabled": false
  },
  "Jwt": {
    "Issuer": "saas-identity",
    "Audience": "vital-saas",
    "PublicKeyPem": "",
    "PublicKeyPemPath": ""
  },
  "IdentityAuth": {
    "BaseAddress": "",
    "TimeoutSeconds": 3
  },
  "ProvisioningWorker": {
    "Enabled": false,
    "MaxAutomaticRetries": 3,
    "LeaseDurationSeconds": 60,
    "InitialRetryDelaySeconds": 15,
    "MaxRetryDelaySeconds": 300,
    "PollIntervalSeconds": 5
  },
  "AllowedHosts": "*"
}
