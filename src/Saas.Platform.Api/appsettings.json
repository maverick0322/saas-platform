{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Platform": {
    "RuntimeMode": "Api"
  },
  "Ports": {
    "Http": 8080
  },
  "InternalGrpc": {
    "Enabled": false,
    "Port": 8092,
    "InternalServiceKey": ""
  },
  "AdminApi": {
    "Enabled": false
  },
  "Jwt": {
    "Issuer": "saas-identity",
    "Audience": "vital-saas",
    "PublicKeyPem": "",
    "PublicKeyPemPath": ""
  },
  "IdentityAuth": {
    "BaseAddress": "",
    "TimeoutSeconds": 3
  },
  "ProvisioningWorker": {
    "Enabled": false,
    "Mode": "Unconfigured",
    "MaxAutomaticRetries": 3,
    "LeaseDurationSeconds": 60,
    "InitialRetryDelaySeconds": 15,
    "MaxRetryDelaySeconds": 300,
    "PollIntervalSeconds": 5
  },
  "CloudNativePg": {
    "Namespace": "saas-tenant-databases",
    "ImageName": "ghcr.io/cloudnative-pg/postgresql:17.12-system-trixie@sha256:0f34d3fb12f415713ec94c3f2aa8295c7975f7114a0a8d360f26c958253bd032",
    "Instances": 1,
    "StorageClass": "local-path",
    "StorageSize": "2Gi",
    "CpuRequest": "100m",
    "CpuLimit": "750m",
    "MemoryRequest": "256Mi",
    "MemoryLimit": "768Mi",
    "ApiCallTimeoutSeconds": 10,
    "ReadinessTimeoutSeconds": 180,
    "ReadinessPollIntervalSeconds": 3
  },
  "AllowedHosts": "*"
}
